# Gradle
.gradle/
build/
out/
repo/

# Minecraft run directories (logs, saves, configs created by runClient/runServer/runData)
run/
runs/
run-data/

# Data generator cache (regenerated by runData)
src/generated/resources/.cache/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse / VS Code
bin/
.settings/
.metadata/
.classpath
.project
*.launch
.vscode/

# Local AI/tooling state (machine-specific, not part of the mod)
.feisuan/
.modmind/
modmind.project.json
docs/last-ai-response.txt

# Compiled / packaged files
*.class
*.jar
*.war
*.nar
*.ear
*.zip
# Exception: the bundled TaCZ gunpack (Beyond The Lumination) must ship with the mod.
# This gun data is NOT encrypted (unlike the YSM model) and is released to tacz/ at startup.
!src/main/resources/assets/gear_forge/tacz/natsu_gunpack.zip
*.tar.gz
*.rar

# Logs and crash dumps
*.log
hs_err_pid*
replay_pid*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Gradle wrapper jar must stay tracked even though *.jar is ignored above.
# Must come AFTER *.jar: gitignore uses the LAST matching pattern.
!gradle/wrapper/gradle-wrapper.jar

# JEI API jars are vendored because Maven download is blocked by TLS in this environment.
!libs/*.jar

# ===== YSM internal model (author requirement: private, never publish source) =====
# The AES key/IV, decrypt routine, encrypted model and its protection mixins are
# kept local only and must NEVER be committed. Plaintext .ysm/.enc and every
# file that reveals the encryption scheme are excluded here.
src/main/resources/assets/gear_forge/ysm/*.ysm
src/main/resources/assets/gear_forge/ysm/*.ysm.enc
src/main/java/com/hana/gear_forge/entity/ysm/YsmModelInstaller.java
src/main/java/com/hana/gear_forge/entity/ysm/YsmModelGuard.java
src/main/java/com/hana/gear_forge/mixin/YsmModelAccessMixin.java
src/main/java/com/hana/gear_forge/mixin/YsmModelSyncGuardMixin.java
src/main/java/com/hana/gear_forge/mixin/YsmModelGuiHideMixin.java
src/main/java/com/hana/gear_forge/mixin/YsmExportCommandMixin.java
src/main/java/com/hana/gear_forge/mixin/YsmReloadMixin.java
src/main/java/com/hana/gear_forge/mixin/YsmProxyNameMixin.java
src/main/resources/gear_forge.ysm.mixins.json
