# Gradle
.gradle/
build/
out/
repo/

# Minecraft run directories (logs, saves, configs created by runClient/runServer/runData)
run/
runs/
run-data/

# Data generator cache (regenerated by runData)
src/generated/resources/.cache/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse / VS Code
bin/
.settings/
.metadata/
.classpath
.project
*.launch
.vscode/

# Local AI/tooling state (machine-specific, not part of the mod)
.feisuan/
.modmind/
modmind.project.json
docs/last-ai-response.txt

# Compiled / packaged files
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs and crash dumps
*.log
hs_err_pid*
replay_pid*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Gradle wrapper jar must stay tracked even though *.jar is ignored above.
# Must come AFTER *.jar: gitignore uses the LAST matching pattern.
!gradle/wrapper/gradle-wrapper.jar

# JEI API jars are vendored because Maven download is blocked by TLS in this environment.
!libs/*.jar
